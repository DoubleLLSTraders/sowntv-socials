rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Add more admin emails here, then publish rules.
    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'tunezken@gmail.com',
          'admin@sowntv.com'
        ];
    }

    function ownProfileCreate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role == 'user';
    }

    function ownProfileUpdate(uid) {
      return isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == resource.data.role;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if ownProfileCreate(uid) || isAdmin();
      allow update: if ownProfileUpdate(uid) || isAdmin();
      allow delete: if false;

      match /orders/{orderId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) || isAdmin();
        allow delete: if false;
      }

      match /transactions/{txId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) || isAdmin();
        allow delete: if false;
      }

      match /tickets/{ticketId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid) || isAdmin();
        allow delete: if false;
      }
    }
  }
}
