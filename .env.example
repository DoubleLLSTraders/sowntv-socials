PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_BASIC_AUTH=
PAYHERO_ACCOUNT_ID=
PAYHERO_CHANNEL_ID=
PAYHERO_LIPWA_URL=https://app.payhero.co.ke/lipwa/8895
