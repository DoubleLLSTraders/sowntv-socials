JESKIE_API_URL=https://jeskieinc.com/api/v2
JESKIE_API_KEY=paste_your_jeskie_api_key_here

# HMAC secret for login cookies — use a long random string (32+ chars). Required in production.
AUTH_SECRET=change-me-to-a-long-random-string

# First admin account (created on first launch). Extra admins: comma-separated.
ADMIN_EMAIL=admin@sowntv.com
ADMIN_EMAILS=tunezken@gmail.com
ADMIN_PASSWORD=ChangeMe123!

# Retail price = wholesale × this number (2 to 5 is typical)
MARKUP_MULTIPLIER=2.5

# Shown to customers on the wallet page
NEXT_PUBLIC_BRAND=SownTV Socials
NEXT_PUBLIC_CURRENCY=KES
NEXT_PUBLIC_DEPOSIT_NUMBER=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Firebase Auth (web app config — public by design)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
